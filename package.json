{
  "name": "exercicios-4-5-6-logs-middleware-pm2",
  "version": "1.0.0",
  "description": "Exercicios 4, 5 e 6: logs estruturados (Winston), middleware de logging de requisicoes e diagnostico de processo com PM2",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pm2:start": "npm run build && npx pm2 start ecosystem.config.js",
    "pm2:logs": "npx pm2 logs api",
    "pm2:restart-count": "npx pm2 list",
    "pm2:stop": "npx pm2 delete api"
  },
  "dependencies": {
    "express": "^4.19.2",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "pm2": "^5.4.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
